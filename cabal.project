-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-10-06T21:15:24Z
  , cardano-haskell-packages 2026-10-06T19:41:19Z


constraints:
  -- haskell.nix patch does not work for 1.6.8
  -- grapesy currently depends on crypton-x509-system (>=1.6 && <1.7)
  , any.crypton-x509-system < 1.6.8 || >= 1.7

  -- EXPERIMENT: force cardano-crypto-class up to the 2.6.x line (which
  -- requires crypton ^>=1.1) to see how far the crypton >= 1.1 / memory ->
  -- ram migration gets. Several local packages pin cardano-crypto-class
  -- ^>=2.5, so their bound needs an allow-newer below too.
  , any.cardano-crypto-class ^>=2.6

  -- EXPERIMENT: cardano-crypto-1.2.0 (the version the solver reaches for
  -- otherwise) still uses the old `memory` package for ByteArrayAccess,
  -- which doesn't unify with crypton-1.1.4's `ram`-based Digest instances.
  -- cardano-crypto-1.4.0 (already in CHaP) has switched to ram >=0.22.
  , any.cardano-crypto >= 1.4

  -- haskell.nix tries to use 0.7.1.5 for some reason
  , any.proto-lens >= 0.7.1.7
  -- https://github.com/channable/alfred-margaret/pull/76
  , any.alfred-margaret < 2.1.1.0 || > 2.1.1.0

-- acts has a finitary flag; disabling it avoids pulling in finitary entirely,
-- which sidesteps the GHC type-checker plugin incompatibility with
-- cross-compilation to Windows (finitary-2.2.0.0+)
package acts
  flags: -finitary

packages:
  cardano-node
  cardano-node-capi
  cardano-node-chairman
  cardano-submit-api
  cardano-testnet
  cardano-tracer
  bench/cardano-profile
  bench/cardano-topology
  bench/locli
  bench/plutus-scripts-bench
  bench/tx-generator
  bench/cardano-timeseries-io
  bench/trace-schemas/scripts/schema-gen
  trace-forward

-- Shipped as a release binary but not a dependency of any local package, so it
-- has to be added to the install plan explicitly.
extra-packages: dmq-node >= 0.7.0.0

program-options
  ghc-options: -Werror

test-show-details: direct

-- Always write GHC env files, because they are needed for ghci.
write-ghc-environment-files: always

package cryptonite
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package snap-server
  flags: -openssl

package bitvec
  flags: -simd

package cardano-diffusion
  flags: +optparse-applicative-fork

-- required for haddocks to build successfully
package plutus-scripts-bench
  haddock-options: "--optghc=-fplugin-opt=PlutusTx.Plugin:defer-errors"

-- There is a suspected bug in `cabal` (https://github.com/haskell/cabal/issues/11663)
-- that can be worked around with the following allow-newer stanzas
allow-newer:
  , io-sim:time
  , io-classes:time

  -- EXPERIMENT: these packages pin cardano-crypto-class to <2.6 (either
  -- ^>=2.5 or an explicit >=x.y && <2.6); let them accept the 2.6.x line
  -- so crypton can move to >= 1.1. (cardano-api's own bound is already
  -- ^>=2.6 on the erikd/crypton+ram SRP, cardano-node/-chairman/
  -- cardano-submit-api/cardano-testnet's own bounds were widened to
  -- ^>=2.5||^>=2.6 directly, and ouroboros-consensus's own bound is already
  -- ^>=2.5||^>=2.6 on the erikd/ram SRP, so none of those need an entry
  -- here.)
  , cardano-cli:cardano-crypto-class
  , cardano-keys:cardano-crypto-class
  , cardano-ledger-binary:cardano-crypto-class
  , cardano-ledger-core:cardano-crypto-class
  , cardano-ledger-mary:cardano-crypto-class
  , cardano-ledger-shelley:cardano-crypto-class
  , cardano-protocol:cardano-crypto-class
  , cardano-protocol-tpraos:cardano-crypto-class
  , kes-agent:cardano-crypto-class
  , kes-agent-crypto:cardano-crypto-class

  -- EXPERIMENT: cardano-cli (CHaP, unmodified) pins cardano-crypto-wrapper
  -- ^>=1.7; let it accept the erikd/ram-based 1.8.0.0 SRP above.
  -- (cardano-api's own bound is already ^>=1.7||^>=1.8, no entry needed.)
  , cardano-cli:cardano-crypto-wrapper

  -- EXPERIMENT: cardano-api PR #1292 now depends on the new cardano-keys
  -- package (CHaP 11.0.0.0, extracted from cardano-api's own key-handling
  -- modules -- Ed25519Bip32.hs/Mnemonic.hs/Sign.hs, the actual crypton/ram
  -- fix targets, stayed in cardano-api; cardano-keys took the rest, e.g.
  -- Leios.hs, which is now just a re-export). cardano-keys itself still pins
  -- cardano-crypto-class ^>=2.5 and cardano-crypto-wrapper ^>=1.7 natively
  -- (no memory dependency though, so not a blocker otherwise); let it accept
  -- the widened versions.
  , cardano-keys:cardano-crypto-wrapper

  -- TEMPORARY: cardano-keys (CHaP 11.0.0.0, unmodified) pins
  -- cardano-ledger-core ^>=1.21 and cardano-ledger-shelley ^>=1.19, both
  -- excluding the versions the cardano-ledger monorepo SRP above now
  -- provides (1.22.0.0 / 1.20.0.0); let it accept them.
  , cardano-keys:cardano-ledger-core
  , cardano-keys:cardano-ledger-shelley

  -- TEMPORARY: cardano-api PR #1292 (erikd/crypton+ram) and cardano-keys
  -- (CHaP 11.0.0.0, a cardano-api dependency) both still pin
  -- cardano-protocol ^>=0.1; let them accept the 0.2.0.0 the bumped
  -- cardano-ledger SRP above now provides (only adds a new
  -- Cardano.Protocol.Leios.BlockHeader module -- nothing either package
  -- depends on changed).
  , cardano-api:cardano-protocol
  , cardano-keys:cardano-protocol

  -- TEMPORARY: ekg-forward (CHaP, latest 1.3, unmodified) still pins
  -- ouroboros-network (lib api) ^>=1.2, excluding the 1.3.0.0 that
  -- ouroboros-consensus main (see SRP below) now provides. It only uses
  -- NodeToClient-independent parts of the api sublibrary; let it accept.
  , ekg-forward:ouroboros-network

-- cabal-allow-newer begin
if impl(ghc >= 9.14)
  allow-newer:
    , async-timer:unliftio-core
    , attoparsec-iso8601:time
    , bytestring-trie:base
    , canonical-json:containers
    , cborg:base
    , cborg:containers
    , cborg-json:aeson
    , cborg-json:base
    , compact:base
    , crypton-connection:tls
    , dependent-map:containers
    , diff-containers:base
    , dictionary-sharing:containers
    , dmq-node:containers
    , dmq-node:time
    , ekg-json:aeson
    , ekg-json:text
    , ekg-prometheus-adapter:containers
    , ekg-wai:time
    , errors:transformers-compat
    , fs-sim:QuickCheck
    , grapesy:aeson
    , grapesy:base
    , grapesy:containers
    , grapesy:time-manager
    , grapesy:tls
    , grpc-spec:aeson
    , grpc-spec:base
    , grpc-spec:containers
    , iohk-monitoring:contra-tracer
    , lens-family:containers
    , lens-family-core:containers
    , locli:ouroboros-network
    , microstache:aeson
    , monad-control:transformers-compat
    , nothunks:containers
    , nothunks:time
    , optparse-generic:time
    , partial-order:containers
    , pipes-safe:containers
    , pipes-safe:mtl
    , pipes-safe:primitive
    , pipes-safe:transformers
    , prometheus:containers
    , safe-wild-cards:template-haskell
    , serdoc-core:template-haskell
    , serialise:base
    , serialise:containers
    , serialise:time
    , servant:QuickCheck
    , servant:base
    , servant-server:aeson
    , servant-server:attoparsec
    , servant-server:base
    , servant-server:base-compat
    , servant-server:base64-bytestring
    , servant-server:bytestring
    , servant-server:containers
    , servant-server:http-api-data
    , servant-server:http-types
    , servant-server:network
    , servant-server:servant
    , servant-server:text
    , servant-server:transformers
    , servant-server:warp
    , strict-checked-vars:io-classes
    , strict-stm:base
    , strict-stm:io-classes
    , tdigest:base
    , time-locale-compat:time
    , tracer-transformers:contra-tracer
    , vary:aeson
    , with-utf8:base
-- cabal-allow-newer end

-- IMPORTANT
-- Do NOT add more source-repository-package stanzas here unless they are strictly
-- temporary! Please read the section in CONTRIBUTING about updating dependencies.

-- cardano-ledger: master tip (c9e53ed9), kept in sync with
-- ouroboros-consensus's own cardano-ledger SRP below (see that comment) --
-- don't bump this independently of that pin. Pulling in the whole monorepo,
-- not just eras/byron/crypto, because ouroboros-consensus's
-- erikd/update-ledger-srp (below) transitively needs cardano-ledger-binary
-- ^>=1.10, small-steps ^>=1.2 and cardano-ledger-core ^>=1.22 -- none
-- released to CHaP yet -- and every other era package in the monorepo has
-- to move in lockstep with whichever of these it depends on.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger.git
  tag: c9e53ed9b9f6a7b2f20aedc7fa0b84da7725ede3
  --sha256: sha256-Mpmm0oFhH4dyqka/yKb95ilHzpKbTSAQ1DVkDPoV2FA=
  subdir:
    eras/allegra/impl
    eras/alonzo/impl
    eras/babbage/impl
    eras/byron/chain/executable-spec
    eras/byron/crypto
    eras/byron/ledger/executable-spec
    eras/byron/ledger/impl
    eras/conway/impl
    eras/dijkstra/impl
    eras/mary/impl
    eras/shelley/impl
    eras/shelley/test-suite
    libs/cardano-data
    libs/cardano-ledger-api
    libs/cardano-ledger-binary
    libs/cardano-ledger-core
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    libs/non-integral
    libs/small-steps
    libs/vector-map

-- cardano-base (pre-DST-internalisation cardano-crypto-leios): pulled in via
-- ouroboros-consensus's own cardano-ledger SRP above needing
-- cardano-crypto-leios ^>=0.3, which doesn't exist in CHaP. Pinned to
-- 3d5e2ba1 rather than cardano-base's current master tip: the very next
-- commit (58f5a53a) refactors cardano-crypto-class's BLS12-381 DSIGN API in
-- a way cardano-crypto-leios's source (at any commit past that point) is
-- written against, but CHaP's published cardano-crypto-class-2.6.0.0 (what
-- this project resolves cardano-crypto-class from) still has the
-- pre-refactor shape. Matches ouroboros-consensus's own pin for the same
-- reason -- keep them in sync.
source-repository-package
  type: git
  location: https://github.com/intersectmbo/cardano-base.git
  tag: 3d5e2ba1e76b7cd3bead8bd3f81a2e7ee743ce5c
  --sha256: sha256-Wr6CZW4OR4nsbARIbLKIf61jQfO1WsiT9HPLV+mfZYU=
  subdir: cardano-crypto-leios

-- ouroboros-consensus 5.0.0.0: "Release consensus 5.0" (#2356) published
-- everything the erikd/update-ledger-srp branch had accumulated
-- (ouroboros-network, kes-agent, cardano-base SRPs, and its own
-- cardano-config dependency) to CHaP -- including 5.0.0.0 itself. Verified
-- this resolves to the exact same content as the SRP it replaces: with the
-- SRP removed, `cabal build` picked CHaP's 5.0.0.0 and immediately reported
-- "Up to date" against the already-built SRP'd tree -- same content hash,
-- not just the same .cabal metadata. No SRP needed at all any more; bumped
-- cardano-node's own bound from ^>=4.2.0.1 to ^>=5.0 to match (the
-- ouroboros-consensus/lsm/cardano/diffusion/protocol sublibrary names are
-- unchanged).
-- cardano-api 11.8.0.0: no SRP needed -- it's on CHaP (verified
-- byte-identical to what this used to pin as a git SRP, 6d06caa36). The
-- erikd/crypton+ram feature branch (formerly pinned here as PR #1292,
-- f4f072cf5) had its own crypton>=1.1 migration and a pile of
-- ledger/consensus-bump-chasing fixes, but cardano-api's own master moved
-- so far in the meantime (crypton>=1.1 done upstream via its own
-- cabal.project constraint+SRP mechanism, a large unrelated UTXORPC
-- mempool-streaming refactor, the same ouroboros-consensus 5.0/5.1 and
-- Cardano/Api/Block.hs redundant-constraint fixes we needed, done
-- natively) that rebasing wasn't practical -- 84 files differed, mostly
-- real feature removals, not just version churn. Nothing from
-- erikd/crypton+ram is still needed for cardano-api itself.
--
-- cardano-rpc does NOT get the same treatment, despite living in the same
-- git repo/commit: CHaP's cardano-rpc-11.4.0.0 is a stale release that
-- predates the era-parameterised StakePoolParams/PoolCert and the
-- crypton>=1.1 migration (verified: building against it fails with
-- `L.PoolCert`/`L.StakePoolParams` "expecting one more argument" and a
-- missing `BA.ByteArrayAccess` instance for crypton-1.1.5's Ed25519
-- Signature type) -- each package in this monorepo is released to CHaP
-- independently, so same-commit doesn't mean same-CHaP-release. Still
-- needs the git SRP, pointing at the exact same commit as cardano-api
-- above for consistency.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-api.git
  tag: 6d06caa36c73681cc1d0eca254abc078e3a03f40
  subdir: cardano-rpc

-- cardano-cli erikd/crypton-ram, same situation as cardano-api above: reset
-- to origin/master (2fe22702f) and redid the fixes fresh, rather than
-- rebasing the old PR #1417 branch. Widens its own cardano-api bound
-- (^>=11.7 -> ^>=11.7||^>=11.8) and cardano-diffusion:ping bound
-- (^>=1.1.1 -> ^>=1.1.1||^>=1.3) to match this repo's pins above, and
-- adapts to: StakePoolParameters' new stakePoolBlsKey field, StakePoolParams
-- becoming era-parameterized (genesis testnet-data code), 9 new
-- Leios/endorser-block IntroducedInDijkstraPParams fields, SerialisedPoolState
-- gaining an era parameter, mkStakePoolState gaining a leading EpochNo,
-- KESPeriod losing its Integral instance, and HasTextEnvelope's
-- textEnvelopeType becoming a standalone function in golden tests.
-- dbb70a922 is the current, pushed tip.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-cli.git
  tag: dbb70a922fb77bc3d85cee043923b78352be0e2c
  subdir: cardano-cli
